{
  "modName": "f4sr",
  "displayName": "F4SR",
  "minMcmVersion": 2,
  "content": [
    {
      "type": "section",
      "text": "Upscaling"
    },
    {
      "id": "bEnableUpscaling:Main",
      "type": "switcher",
      "text": "Upscaling",
      "help": "Turns F4SR upscaling on or off. Applies when you close the menu.",
      "valueOptions": {
        "sourceType": "ModSettingBool"
      }
    },
    {
      "id": "iBackend:Main",
      "type": "dropdown",
      "text": "Upscaler",
      "help": "FSR 4.1: best image, highest GPU cost. FSR 3.1: lightest. XeSS: runs on any GPU. Applies when you close the menu.",
      "valueOptions": {
        "sourceType": "ModSettingInt",
        "options": [
          "FSR 3.1",
          "FSR 4.1",
          "XeSS"
        ]
      }
    },
    {
      "id": "iQualityMode:Main",
      "type": "dropdown",
      "text": "Render Resolution",
      "help": "Lower = more FPS, softer image. Native = AA only. Applies on return to gameplay; the panel says if a restart is needed.",
      "valueOptions": {
        "sourceType": "ModSettingInt",
        "options": [
          "Native (AA only)",
          "Quality (67%)",
          "Balanced (59%)",
          "Performance (50%)"
        ]
      }
    },
    {
      "id": "fSharpness:Main",
      "type": "slider",
      "text": "Sharpening",
      "help": "FSR sharpening (RCAS); 0 = off. XeSS ignores it. Keep low if ENB also sharpens.",
      "valueOptions": {
        "min": 0,
        "max": 1,
        "step": 0.05,
        "sourceType": "ModSettingFloat"
      }
    },
    {
      "id": "bReactiveMask:Main",
      "type": "switcher",
      "text": "Transparency Mask",
      "help": "Stops particles, fire, glass and water from smearing. Recommended on. Turning it on needs a restart.",
      "valueOptions": {
        "sourceType": "ModSettingBool"
      }
    },
    {
      "type": "section",
      "text": "Frame Generation"
    },
    {
      "id": "bEnableFrameGeneration:Main",
      "type": "switcher",
      "text": "Frame Generation",
      "help": "Smoother motion, a little more latency. Needs upscaling. Classic + XeSS-FG: turning it on needs a restart.",
      "valueOptions": {
        "sourceType": "ModSettingBool"
      }
    },
    {
      "id": "iFrameGenEngine:Main",
      "type": "dropdown",
      "text": "Frame Generation Engine",
      "help": "XeSS-FG: 2X-4X, smoother pacing, sharp UI pipeline. FSR-FG: 2X fallback, Classic pipeline only. Needs a restart.",
      "valueOptions": {
        "sourceType": "ModSettingInt",
        "options": [
          "FSR-FG (2X)",
          "XeSS-FG (2X - 4X, recommended)"
        ]
      },
      "groupControl": 2
    },
    {
      "id": "iXeFGMode:Main",
      "type": "dropdown",
      "text": "XeSS-FG Multiplier",
      "help": "Pick it so real FPS x multiplier is near your refresh rate. Higher only adds latency. Applies live.",
      "valueOptions": {
        "sourceType": "ModSettingInt",
        "options": [
          "2X",
          "3X",
          "4X"
        ]
      },
      "groupCondition": 2
    },
    {
      "id": "iPipeline:Main",
      "type": "dropdown",
      "text": "Render Pipeline",
      "help": "UI Native: game and ENB at render size, UI drawn at full resolution. Classic: older path. Needs a restart.",
      "valueOptions": {
        "sourceType": "ModSettingInt",
        "options": [
          "Classic",
          "UI Native (recommended, experimental)"
        ]
      },
      "groupCondition": 2
    },
    {
      "type": "section",
      "text": "ReShade"
    },
    {
      "id": "bReShadeBeforeUI:Main",
      "type": "switcher",
      "text": "ReShade Effects Before UI",
      "help": "Effects go under the HUD. UI Native: with ENB, before upscaling (exact depth). Screen-fixed overlays may smear.",
      "valueOptions": {
        "sourceType": "ModSettingBool"
      }
    },
    {
      "id": "bReShadeDepth:Main",
      "type": "switcher",
      "text": "ReShade Depth",
      "help": "Gives ReShade the game's depth (AO, DOF, fog) under XeSS-FG and at reduced render sizes in Classic. Applies live.",
      "valueOptions": {
        "sourceType": "ModSettingBool"
      }
    },
    {
      "type": "section",
      "text": "Diagnostics"
    },
    {
      "id": "bFrameGenOverlay:Main",
      "type": "switcher",
      "text": "Status Panel",
      "help": "Top-left panel: upscaler, sizes, GPU time, FG rate. Switches live. Errors show it for 30 s even when off.",
      "valueOptions": {
        "sourceType": "ModSettingBool"
      }
    },
    {
      "id": "bDebugView:Main",
      "type": "switcher",
      "text": "FSR Debug View",
      "help": "Shows FidelityFX's debug view (motion vectors, reactive mask). Troubleshooting only.",
      "valueOptions": {
        "sourceType": "ModSettingBool"
      }
    },
    {
      "id": "bForceReset:Main",
      "type": "switcher",
      "text": "Force History Reset",
      "help": "Clears upscaler history every frame. If ghosting goes away, report it with f4sr.log.",
      "valueOptions": {
        "sourceType": "ModSettingBool"
      }
    },
    {
      "id": "bFrameGenCapture:Main",
      "type": "switcher",
      "text": "Capture FG Sample Frames",
      "help": "Developer diagnostic: saves frame-generation sample images. May stutter. Leave off.",
      "valueOptions": {
        "sourceType": "ModSettingBool"
      }
    }
  ]
}
